# Copy this file to <deployment-root>/config/application-prod.yml.
# Keep the copied file and all real values outside Git.

server:
  address: 127.0.0.1
  port: 8080

management:
  server:
    address: 127.0.0.1
    port: 8081
  endpoints:
    web:
      exposure:
        include: health,metrics,prometheus

spring:
  datasource:
    # Include connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true in NEXUS_DB_URL.
    # A separately configured Flyway URL must use the same UTC options.
    url: ${NEXUS_DB_URL}
    username: ${NEXUS_DB_USERNAME}
    password: ${NEXUS_DB_PASSWORD}
    hikari:
      maximum-pool-size: ${NEXUS_DB_POOL_MAX_SIZE}
      minimum-idle: ${NEXUS_DB_POOL_MIN_IDLE}
  flyway:
    user: ${NEXUS_FLYWAY_USERNAME}
    password: ${NEXUS_FLYWAY_PASSWORD}

nexus:
  auth:
    jwt:
      issuer: nexus
      access-token-ttl: 30m
      secret: ${NEXUS_JWT_SECRET}
  screenshot-jobs:
    result-directory: ${NEXUS_SCREENSHOT_JOB_RESULT_DIR}

# Use an absolute deployment-host path, such as /opt/nexus/logs on Linux.
logging:
  pattern:
    dateformat: "yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC"
  file:
    name: ${NEXUS_LOG_DIR}/nexus.log
  logback:
    rollingpolicy:
      file-name-pattern: ${NEXUS_LOG_DIR}/nexus.%d{yyyy-MM-dd,UTC}.%i.log.gz
