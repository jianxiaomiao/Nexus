abi <abi/4.0>,
include <tunables/global>

# Ubuntu 23.10+ restricts unprivileged user namespaces for downloaded
# Chromium builds. Allow only the immutable Playwright 1.63.0 headless-shell
# executable used by Nexus; do not disable the kernel restriction globally.
profile nexus-playwright-headless-shell /opt/nexus/browsers/playwright-1.63.0/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell flags=(unconfined) {
  userns,

  include if exists <local/nexus-playwright-headless-shell>
}
